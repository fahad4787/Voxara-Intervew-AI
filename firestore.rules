rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function setupComplete() {
      return exists(/databases/$(database)/documents/meta/setup)
        && get(/databases/$(database)/documents/meta/setup).data.complete == true;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.email is string
        && data.createdAt is string
        && data.updatedAt is string
        && (!('role' in data) || data.role in ['superadmin', 'admin']);
    }

    function preservesInterviewIdentity() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.token == resource.data.token
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /meta/{docId} {
      allow read: if docId == 'setup';
      allow create: if docId == 'setup'
        && isAuthenticated()
        && !setupComplete()
        && request.resource.data.complete == true
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      // Portal admins share one tenant — any signed-in admin can see the roster.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && isValidUser(request.resource.data)
        && (!setupComplete() || request.auth.uid == get(/databases/$(database)/documents/meta/setup).data.ownerId);
      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /interviews/{interviewId} {
      // Token/id act as invite secrets for candidates (no Admin SDK required).
      allow get: if true;
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if preservesInterviewIdentity();
      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
    }

    match /interviewTokens/{token} {
      allow get: if true;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['interviewId', 'ownerId'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.interviewId is string;
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.interviewId == resource.data.interviewId;
      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
      allow list: if false;
    }
  }
}
